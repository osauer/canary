# Experimental trading config template.
#
# This file is inert while named config.toml.trading. To activate it, move it to
# ~/.config/ibkr/config.toml, verify every pinned value, then run:
#
#   canary restart
#   canary trading status
#
# Stable Canary releases are read-only. Trading builds are experimental,
# provided as-is, and intended for explicit operator testing.

[gateway]
# Pick one concrete endpoint. Do not rely on auto-detection when trading.
# TWS paper:      7497
# IB Gateway paper: 4002
# TWS live:       7496
# IB Gateway live: 4001
port = 7497

# Trading requires a pinned client ID and a concrete account.
client_id = 15
account = "DU1234567"

[trading]
# mode is the only enablement switch: "disabled" (default), "paper", or "live".
# Every broker write always requires a submit-eligible preview token; that is
# invariant, not a config key.
mode = "paper"

max_notional = 10000
max_option_contracts = 5

allow_stock_short = false
allow_option_sell_to_open = false

# There are no separate live acknowledgement keys: [trading].mode = "live" plus
# the [gateway] pins above are the whole config gate, and the loader rejects the
# retired acknowledgement keys. Before switching to live, verify the exact live
# endpoint, client ID, and account values. Paper-smoke evidence is informational
# and release-pipeline-only; it does not gate live mode.
