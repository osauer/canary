{
  "enabledPlugins": {
    "canary@canary": true
  },
  "extraKnownMarketplaces": {
    "canary": {
      "source": {
        "source": "github",
        "repo": "osauer/canary"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(make commit-check)",
      "Bash(make check)",
      "Bash(make smoke)",
      "Bash(make test)",
      "Bash(make changelog-lint)",
      "Bash(make hook-version-check)",
      "Bash(make plugin-check)",
      "Bash(go vet *)",
      "Bash(canary status)",
      "Bash(canary status *)",
      "Bash(canary version)",
      "Bash(canary trading status *)",
      "Bash(canary orders *)",
      "Bash(canary proposals preview *)",
      "Bash(canary order status *)",
      "Bash(canary positions *)",
      "Bash(canary rules)",
      "Bash(canary rules *)",
      "Bash(make smoke-fast)",
      "Bash(make app-check)",
      "Bash(make account-data-check)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git tag *)",
      "Bash(git reset --hard *)"
    ]
  }
}
